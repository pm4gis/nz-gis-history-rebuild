---
interface Props {
  nodes: { id: string; label: string; kind?: string; url?: string }[];
  edges: { id: string; a: string; b: string; label?: string }[];
  centralId?: string;
  fullUrl?: string;
}
const { nodes, edges, centralId = "", fullUrl = "/network/" } = Astro.props as Props;
const cleanNodes = nodes.filter((node) => node?.id && node?.label);
const ids = new Set(cleanNodes.map((node) => node.id));
const cleanEdges = edges.filter((edge) => edge?.a !== edge?.b && ids.has(edge.a) && ids.has(edge.b));
const payload = JSON.stringify({ nodes: cleanNodes, edges: cleanEdges, centralId }).replace(/</g, "\\u003c");
---
<div class="mini-network" data-mini-network>
  <div class="mini-network-graph" data-mini-canvas aria-label="Interactive diagram of the records connected to this page"></div>
  <script type="application/json" data-mini-json set:html={payload}></script>
  <p class="mini-network-instructions">Drag to move a record · select to inspect</p>
  <div class="mini-network-selection" data-mini-selection aria-live="polite"><span>Select a record to open its page.</span></div>
  <details class="mini-network-alternative">
    <summary>All records in this diagram ({cleanNodes.length})</summary>
    <ul>{cleanNodes.map((node) => <li>{node.url ? <a href={node.url}>{node.label}</a> : <span>{node.label}</span>}</li>)}</ul>
  </details>
  <a class="text-link" href={fullUrl}>Explore in the full network →</a>
</div>
<script>
  // @ts-nocheck
  import { MultiUndirectedGraph } from "graphology";
  import Sigma, { DEFAULT_STYLES } from "sigma";
  const supportsWebGL = () => { try { const c = document.createElement("canvas"); return !!(c.getContext("webgl2") || c.getContext("webgl")); } catch { return false; } };
  document.querySelectorAll("[data-mini-network]").forEach((host) => {
    const stage = host.querySelector("[data-mini-canvas]");
    const selection = host.querySelector("[data-mini-selection]");
    const payload = JSON.parse(host.querySelector("[data-mini-json]").textContent);
    if (!payload.nodes.length) {
      stage.hidden = true;
      host.querySelector(".mini-network-instructions").hidden = true;
      return;
    }
    const getThemeColours = () => {
      const style = getComputedStyle(document.documentElement);
      const colour = (name) => style.getPropertyValue(name).trim();
      return {
        person: colour("--graph-person"), organisation: colour("--graph-organisation"),
        business: colour("--graph-business"), project: colour("--graph-project"),
        technology: colour("--graph-technology"), story: colour("--graph-story"),
        event: colour("--graph-event"), theme: colour("--graph-theme"),
        index: colour("--graph-index"), selection: colour("--graph-selection"),
        edge: colour("--graph-edge"), label: colour("--ink"), surface: colour("--surface"),
      };
    };
    const kindToken = (kind) => ({
      Person: "person", Organisation: "organisation", Agency: "organisation", Council: "organisation",
      Business: "business", Company: "business", Project: "project", System: "technology",
      Technology: "technology", Story: "story", Event: "event", Theme: "theme", Index: "index",
    })[kind] || "organisation";
    let colours = getThemeColours();
    if (!supportsWebGL()) {
      stage.hidden = false;
      host.querySelector(".mini-network-instructions").hidden = false;
      stage.setAttribute("role", "group");
      stage.setAttribute("aria-label", "Network diagram. Select a record to inspect its connections.");
      let selectedMiniId = "";
      const drawMiniSvg = () => {
        stage.replaceChildren();
        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("viewBox", "0 0 360 235");
        svg.setAttribute("class", "mini-network-svg");
        svg.setAttribute("role", "group");
        svg.setAttribute("aria-label", "Connected records diagram");
        const centre = { x: 180, y: 108 };
        const others = payload.nodes.filter((node) => node.id !== payload.centralId);
        const points = new Map(payload.nodes.map((node) => {
          if (node.id === payload.centralId) return [node.id, centre];
          const index = others.findIndex((item) => item.id === node.id);
          const angle = (2 * Math.PI * index / Math.max(others.length, 1)) - Math.PI / 2;
          const radius = others.length > 18 ? .85 : .72;
          return [node.id, { x: centre.x + Math.cos(angle) * radius * 145, y: centre.y + Math.sin(angle) * radius * 85 }];
        }));
        const make = (name, attrs) => {
          const element = document.createElementNS("http://www.w3.org/2000/svg", name);
          Object.entries(attrs).forEach(([key, value]) => element.setAttribute(key, String(value)));
          return element;
        };
        payload.edges.forEach((edge) => {
          const a = points.get(edge.a), b = points.get(edge.b);
          if (!a || !b) return;
          svg.append(make("line", { x1:a.x, y1:a.y, x2:b.x, y2:b.y, class:"mini-network-svg-edge" }));
        });
        payload.nodes.forEach((node) => {
          const point = points.get(node.id);
          const selected = node.id === selectedMiniId;
          const group = make("g", { tabindex:"0", role:"button", "aria-pressed":String(selected),
            "data-mini-node-id":node.id, class:"mini-network-svg-node" + (selected ? " is-selected" : ""),
            "aria-label":"Inspect " + node.label + (node.kind ? ", " + node.kind : "") });
          group.append(make("circle", { cx:point.x, cy:point.y, r:node.id === payload.centralId ? 12 : 8,
            fill:node.id === payload.centralId ? colours.selection : colours[kindToken(node.kind)] || colours.organisation }));
          const label = make("text", { x:point.x, y:point.y + 21, "text-anchor":"middle" });
          label.textContent = node.label.length > 22 ? node.label.slice(0, 19) + "…" : node.label;
          group.append(label);
          const select = () => {
            selectedMiniId = node.id;
            svg.querySelectorAll("[data-mini-node-id]").forEach((item) => {
              const isSelected = item.dataset.miniNodeId === selectedMiniId;
              item.classList.toggle("is-selected", isSelected);
              item.setAttribute("aria-pressed", String(isSelected));
            });
            selection.replaceChildren();
            const title = document.createElement("strong"); title.textContent = node.label; selection.append(title);
            if (node.kind) { const kind = document.createElement("span"); kind.textContent = " · " + node.kind; selection.append(kind); }
            const count = payload.edges.filter((edge) => edge.a === node.id || edge.b === node.id).length;
            const relationships = document.createElement("span"); relationships.textContent = " · " + count + " connected " + (count === 1 ? "record" : "records"); selection.append(relationships);
            if (node.url) { const link = document.createElement("a"); link.href = node.url; link.textContent = " Open page →"; selection.append(link); }
          };
          group.addEventListener("click", select);
          group.addEventListener("keydown", (event) => { if (["Enter", " "].includes(event.key)) { event.preventDefault(); select(); } });
          svg.append(group);
        });
        stage.append(svg);
      };
      drawMiniSvg();
      window.addEventListener("site:palette-changed", () => { colours = getThemeColours(); drawMiniSvg(); });
      return;
    }
    const graph = new MultiUndirectedGraph();
    const nodeMap = new Map(payload.nodes.map((node) => [node.id, node]));
    const others = payload.nodes.filter((node) => node.id !== payload.centralId);
    payload.nodes.forEach((node) => {
      const central = node.id === payload.centralId;
      const index = others.findIndex((item) => item.id === node.id);
      const angle = (2 * Math.PI * index / Math.max(others.length, 1)) - Math.PI / 2;
      const radius = others.length > 24 ? .93 : .78;
      graph.addNode(node.id, { label: node.label, x: central ? 0 : Math.cos(angle) * radius,
        y: central ? 0 : Math.sin(angle) * radius, color: central ? colours.selection : colours[kindToken(node.kind)], labelTint: colours.label, labelBackdrop: colours.surface, size: central ? 12 : 8 });
    });
    payload.edges.forEach((edge) => {
      if (graph.hasNode(edge.a) && graph.hasNode(edge.b) && !graph.hasEdge(edge.id))
        graph.addUndirectedEdgeWithKey(edge.id, edge.a, edge.b, { label: edge.label || "", color: colours.edge, size: 1.2 });
    });
    let draggedRecently = -Infinity;
    const renderer = new Sigma(graph, stage, {
      settings: { enableNodeDrag: true, autoRescale: "once", itemSizesReference: "screen",
        enableEdgeEvents: false, nodeLabelEvents: "extend", labelDensity: .18, labelRenderedSizeThreshold: 6,
        gestureTarget: "shared", enableCameraRotation: false },
      styles: { nodes: [DEFAULT_STYLES.nodes, { cursor: "grab", labelColor: { attribute: "labelTint" }, labelBackgroundColor: { attribute: "labelBackdrop" }, labelBackgroundPadding: 2 },
        { whenState: "isDragged", then: { cursor: "grabbing", labelVisibility: "visible", depth: "topNodes" } }],
        stage: [{ whenState: "isDragging", then: { cursor: "grabbing" } }] },
    });
    window.addEventListener("site:palette-changed", () => {
      colours = getThemeColours();
      graph.forEachNode((id) => {
        const node = nodeMap.get(id);
        graph.setNodeAttribute(id, "color", id === payload.centralId ? colours.selection : colours[kindToken(node?.kind)]);
        graph.setNodeAttribute(id, "labelTint", colours.label);
        graph.setNodeAttribute(id, "labelBackdrop", colours.surface);
      });
      graph.forEachEdge((id) => graph.setEdgeAttribute(id, "color", colours.edge));
      renderer.refresh();
    });
    renderer.on("nodeDragEnd", () => { draggedRecently = performance.now(); });
    renderer.on("clickNode", ({ node: id }) => {
      if (performance.now() - draggedRecently < 250) return;
      const item = nodeMap.get(id); if (!item) return;
      selection.replaceChildren();
      const title = document.createElement("strong"); title.textContent = item.label; selection.append(title);
      if (item.kind) { const kind = document.createElement("span"); kind.textContent = " · " + item.kind; selection.append(kind); }
      if (item.url) { const link = document.createElement("a"); link.href = item.url; link.textContent = " Open page →"; selection.append(link); }
    });
    if ("ResizeObserver" in window) new ResizeObserver(() => { renderer.resize(true); renderer.refresh(); }).observe(stage);
  });
</script>
