---
interface Props {
  article: any;
  passages?: any[];
  themes?: any[];
  records?: any[];
  events?: any[];
  relationships?: any[];
  images?: any[];
  previousArticle?: any;
  nextArticle?: any;
  compact?: boolean;
}
const { article, passages = [], themes = [], records = [], events = [], relationships = [], images = [], previousArticle, nextArticle, compact = false } = Astro.props as Props;
const recordById = new Map<string, any>(records.map((record) => [record.id, record] as const));
const recordIds = [...new Set(passages.flatMap((passage) => passage.recordIds || []))];
const linkedRecords = recordIds.map((id) => recordById.get(id)).filter(Boolean);
const linkedEvents = events.filter((event) => (event.passageIds || []).some((id) => passages.some((passage) => passage.id === id)));
const relevantRelationships = relationships.filter((item) => recordIds.includes(item.a) && recordIds.includes(item.b));
const themeById = new Map<string, any>(themes.map((theme) => [theme.id, theme] as const));
const articleThemeIds = [...new Set([...(article.themeIds || []), ...passages.flatMap((passage) => passage.themeIds || [])])];
const imageById = new Map<string, any>(images.map((image) => [image.id, image] as const));
const formatDate = (value) => new Date(value + "T00:00:00Z").toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const passageBlocks = (passage) => passage.blocks?.length ? passage.blocks : (passage.paragraphs || []).map((paragraph) => ({ type: "paragraph", ...paragraph }));
const passageSources = (passage) => passageBlocks(passage).flatMap((block) => block.type === "paragraph" ? block.sources || [] : []);
---

<section class="reader-workspace" data-reader-workspace data-article-id={article.id}>
  <header class="story-heading">
    <div class="story-heading-topline">
      <p class="eyebrow">A linked history <span aria-hidden="true">/</span> Story</p>
      <span class="updated-stamp"><span class="pulse-mark" aria-hidden="true"></span> Updated {formatDate(article.updatedAt)}</span>
    </div>
    <h1>{article.title}</h1>
    <p class="story-summary">{article.summary}</p>
    <div class="story-heading-meta">
      <span>{passages.length} passages</span>
      <span>{linkedRecords.length} linked records</span>
    </div>
    {article.headerImageId && imageById.get(article.headerImageId) && (() => {
      const image = imageById.get(article.headerImageId);
      return <figure class="story-cover"><a href={`/images/${image.slug}/`} aria-label={`Open image details for ${image.title}`}><img src={image.assetPath} alt={image.altText} loading="eager" /></a><figcaption>{image.caption || image.title} <a href={`/images/${image.slug}/`}>Image details and source ↗</a></figcaption></figure>;
    })()}
  </header>

  <div class="reader-grid">
    <article class="narrative-column" aria-label="Story">
      {passages.map((passage, index) => (
        <section
          class="reading-passage"
          id={passage.slug}
          data-passage-id={passage.id}
          data-theme-ids={(passage.themeIds || []).join(" ")}
          tabindex="-1"
        >
          <div class="passage-heading">
            <span class="passage-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <p class="passage-date">{linkedEvents.find((event) => (event.passageIds || []).includes(passage.id))?.dateDisplay || ""}</p>
              <h2>{passage.title}</h2>
            </div>
          </div>
          <div class="passage-copy">
            {passageBlocks(passage).map((block) => block.type === "figure" ? (() => {
              const image = block.imageId ? imageById.get(block.imageId) : null;
              return <figure class="reading-figure">
                {image && <a href={`/images/${image.slug}/`} aria-label={`Open image details for ${image.title}`}><img src={image.assetPath} alt={block.alt || image.altText} loading="lazy" /></a>}
                <figcaption>{block.caption}{block.credit && <span class="figure-credit"> {block.credit}</span>}{image && <> <a href={`/images/${image.slug}/`}>Image details and source ↗</a></>}</figcaption>
              </figure>;
            })() : (
              <p>{block.text}</p>
            ))}
          </div>
          <div class="passage-foot">
            {passageSources(passage).length > 0 && <details class="passage-sources">
              <summary>Sources <span>{passageSources(passage).length}</span></summary>
              <ol>
                {passageSources(passage).map((source) => (
                  <li>{source.url ? <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}<span aria-hidden="true"> ↗</span></a> : <span>{source.label}</span>}</li>
                ))}
              </ol>
            </details>}
            <div class="passage-links" aria-label="Linked records">
              {(passage.recordIds || []).filter((recordId) => recordById.get(recordId)?.kind !== "Story").map((recordId) => {
                const record = recordById.get(recordId);
                return record && <a class="inline-record-link" href={record.url}>{record.name}<span aria-hidden="true"> ↗</span></a>;
              })}
            </div>
          </div>
        </section>
      ))}
      {!compact && <>
        {article.sourceNotes?.length > 0 && <details class="source-notes-panel"><summary>Sources and notes <span>{article.sourceNotes.length}</span></summary><ol>{article.sourceNotes.map((note) => <li id={note.id}>{note.text}</li>)}</ol></details>}
        <nav class="story-transport" aria-label="Move through the narrative">
          {previousArticle ? <a class="story-transport-link" href={previousArticle.url}><small>Previous story</small><strong>← {previousArticle.title}</strong></a> : <span></span>}
          {nextArticle ? <a class="story-transport-link story-transport-next" href={nextArticle.url}><small>Continue reading</small><strong>{nextArticle.title} →</strong></a> : <span class="reader-endnote">You’ve reached the current end of the narrative. Follow a linked record, choose a theme, or browse the chronology.</span>}
        </nav>
      </>}
    </article>

    <aside class="reader-context" aria-label="Story connections">
      <div class="context-card context-network-card">
        <div class="context-card-heading">
          <div><p class="eyebrow">Around this story</p><h2>Connected records</h2></div>
          <a class="icon-link" href="/network/" aria-label="Open the full network">↗</a>
        </div>
        {relevantRelationships.length > 0 && <ul class="relationship-list">
          {relevantRelationships.map((relation) => {
            const a = recordById.get(relation.a);
            const b = recordById.get(relation.b);
            return <li>
              <p><a href={a?.url}>{a?.name}</a> <strong>{relation.label}</strong> <a href={b?.url}>{b?.name}</a></p>
              {relation.basis && <small>{relation.basis}</small>}
            </li>;
          })}
        </ul>}
        <ul class="connected-record-list" aria-label="Records discussed in this story">
          {linkedRecords.map((record) => <li><a href={record.url}>{record.name}</a><span>{record.kind}</span></li>)}
        </ul>
        <a class="text-link" href="/network/">Explore the full network <span aria-hidden="true">→</span></a>
      </div>

      <div class="context-card theme-card">
        <p class="eyebrow">Choose a lens</p>
        <h2>Read by theme</h2>
        <p>Select a theme above to focus the passages, or open its page to see related records.</p>
        <div class="theme-tags">
          {articleThemeIds.map((id) => themeById.get(id)).filter(Boolean).map((theme) => (
            <a class="theme-tag" href={`/themes/${theme.slug}/`} style={`--theme-color:${theme.color || "#55b9a7"}`}>{theme.title}<span aria-hidden="true"> ↗</span></a>
          ))}
        </div>
      </div>

    </aside>
  </div>
</section>
