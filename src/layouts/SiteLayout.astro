---
import "../styles/site.css";
import { getCollection } from "astro:content";

const themes = (await getCollection("themes")).map((entry) => entry.data);
const {
  title = "A History of GIS in New Zealand",
  description = "Stories, people, organisations and events in New Zealand’s GIS history.",
  noindex = false,
  pageClass = "",
} = Astro.props;
const activePath = Astro.url.pathname;
const navigation = [
  { label: "Read", href: "/" },
  { label: "Chronology", href: "/timeline/" },
  { label: "Browse", href: "/browse/" },
  { label: "Network", href: "/network/" },
];
const mailSubject = encodeURIComponent(`NZ GIS History suggestion: ${title}`);
const mailBody = encodeURIComponent(`Page or story: ${title}\nURL: ${Astro.url.href}\n\nWhat should be added or changed?\n\nWhat source or memory can help us check it?\n\nWhich people, organisations, projects, themes or dates should connect to it?\n\nYour name (optional):\n`);
---
<!doctype html>
<html lang="en-NZ" data-palette="dark-night">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0d1522" />
    <script is:inline>
      // Apply the stored colour palette before styles and content are painted.
      (() => {
        const valid = ["dark-night", "dark-forest", "light-paper", "light-mist"];
        const key = "nzgis-colour-palette-v1";
        let selected = "dark-night";
        try {
          const saved = JSON.parse(localStorage.getItem(key) || "null");
          if (valid.includes(saved)) selected = saved;
          else {
            const older = JSON.parse(localStorage.getItem("nzgis-skin-v1") || "null");
            if (older === "light") selected = "light-paper";
          }
        } catch {}
        document.documentElement.dataset.palette = selected;
        const backgrounds = { "dark-night": "#0d1522", "dark-forest": "#0b1a16", "light-paper": "#f7f4ec", "light-mist": "#edf3f9" };
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", backgrounds[selected]);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to main content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="A History of GIS in New Zealand, home">
        <span class="wordmark-mark" aria-hidden="true"><span>NZ</span><i>GIS</i></span>
        <span class="wordmark-name">A History of GIS<br />in New Zealand</span>
      </a>
      <nav class="primary-nav" aria-label="Main navigation">
        {navigation.map((item) => (
          <a href={item.href} aria-current={activePath === item.href || (item.href !== "/" && activePath.startsWith(item.href)) ? "page" : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="header-tools">
        <a class="header-search" href="/search/" aria-label="Search the publication"><span aria-hidden="true">⌕</span></a>
        <button class="palette-toggle" type="button" data-palette-toggle aria-label="Change colour theme" title="Change colour theme">
          <span class="palette-swatch" aria-hidden="true"></span>
          <span class="palette-name" data-palette-name>Night</span>
          <span class="palette-cycle" aria-hidden="true">↻</span>
        </button>
      </div>
      <nav class="theme-rail" aria-label="Select themes to shape the reading view">
        <span class="theme-rail-label">Read by theme</span>
        {themes.map((entry) => <button class="theme-chip" type="button" data-theme-choice value={entry.data.id} aria-pressed="false" style={`--theme-color:${entry.data.color || "#55b9a7"}`}>
          <span class="theme-option-dot" aria-hidden="true"></span>{entry.data.title}
        </button>)}
        <button class="theme-clear" type="button" data-clear-themes>Clear</button>
        <span class="theme-status" data-theme-count aria-live="polite">All themes</span>
      </nav>
    </header>
    <main id="main" data-pagefind-body>
      <a class="resume-nudge" data-resume-link hidden><span>Continue reading</span><strong data-resume-title></strong><span aria-hidden="true">↗</span></a>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand"><strong>A History of GIS in New Zealand</strong><span>Narrative, records, images and dates from New Zealand’s GIS history.</span></div>
      <nav class="footer-links" aria-label="Footer navigation"><a href="/stories/preface/">Preface</a><a href="/images/">Images</a><a href="/about/">About</a><a href="/network/">Network</a></nav>
      <a class="suggest-link" href={`mailto:pm4gis@gmail.com?subject=${mailSubject}&body=${mailBody}`}>Suggest an update by email <span aria-hidden="true">↗</span></a>
      <p class="footer-note">The email opens with this page’s title and address, with prompts for your suggested change and its source or context.</p>
    </footer>

    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>
    <script>
      // @ts-nocheck
      const paletteKey = "nzgis-colour-palette-v1";
      const progressKey = "nzgis-reading-progress-v2";
      const themeKey = "nzgis-reader-themes-v1";
      const root = document.documentElement;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const readStored = (key, fallback) => { try { return JSON.parse(localStorage.getItem(key) || JSON.stringify(fallback)); } catch { return fallback; } };

      const paletteOptions = [
        { id: "dark-night", label: "Night", next: "Forest" },
        { id: "dark-forest", label: "Forest", next: "Paper" },
        { id: "light-paper", label: "Paper", next: "Mist" },
        { id: "light-mist", label: "Mist", next: "Night" },
      ];
      const paletteBackgrounds = { "dark-night": "#0d1522", "dark-forest": "#0b1a16", "light-paper": "#f7f4ec", "light-mist": "#edf3f9" };
      let savedProgress = readStored(progressKey, null);
            const resumeLink = document.querySelector("[data-resume-link]");
      if (savedProgress?.url && savedProgress?.passage && resumeLink) {
        const targetHash = "#" + encodeURIComponent(savedProgress.passage);
        if (savedProgress.url !== location.pathname || location.hash !== targetHash) {
          resumeLink.href = savedProgress.url + targetHash;
          resumeLink.querySelector("[data-resume-title]").textContent = savedProgress.title || "Your last story";
          resumeLink.hidden = false;
        }
      }
      const paletteButton = document.querySelector("[data-palette-toggle]");
      const updatePaletteButton = () => {
        const current = paletteOptions.find((option) => option.id === root.dataset.palette) || paletteOptions[0];
        if (!paletteButton) return;
        paletteButton.querySelector("[data-palette-name]").textContent = current.label;
        paletteButton.setAttribute("aria-label", `Colour theme: ${current.label}. Switch to ${current.next}.`);
        paletteButton.title = `Current theme: ${current.label}. Next: ${current.next}.`;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", paletteBackgrounds[current.id]);
      };
      updatePaletteButton();
      paletteButton?.addEventListener("click", () => {
        const index = Math.max(0, paletteOptions.findIndex((option) => option.id === root.dataset.palette));
        const next = paletteOptions[(index + 1) % paletteOptions.length];
        root.dataset.palette = next.id;
        try { localStorage.setItem(paletteKey, JSON.stringify(next.id)); } catch {}
        updatePaletteButton();
        window.dispatchEvent(new CustomEvent("site:palette-changed", { detail: { palette: next.id } }));
      });

      const themeInputs = [...document.querySelectorAll("[data-theme-choice]")];
      const applyThemes = (chosen) => {
        themeInputs.forEach((input) => input.setAttribute("aria-pressed", String(chosen.includes(input.value))));
        const active = new Set(chosen);
        document.querySelectorAll("[data-theme-ids]").forEach((item) => {
          const ids = item.dataset.themeIds.trim().split(/\s+/).filter(Boolean);
          const strict = item.hasAttribute("data-theme-filter-strict");
          const visible = active.size === 0 || (strict ? ids.some((id) => active.has(id)) : ids.length === 0 || ids.some((id) => active.has(id)));
          item.hidden = !visible;
        });
        const count = document.querySelector("[data-theme-count]");
        if (count) count.textContent = chosen.length ? `${chosen.length} selected` : "All themes";
        localStorage.setItem(themeKey, JSON.stringify(chosen));
        window.dispatchEvent(new CustomEvent("reader:themes-changed", { detail: { themes: chosen } }));
      };
      const savedThemes = readStored(themeKey, []);
      applyThemes(Array.isArray(savedThemes) ? savedThemes : []);
      themeInputs.forEach((input) => input.addEventListener("click", () => {
        const chosen = readStored(themeKey, []);
        const next = chosen.includes(input.value) ? chosen.filter((id) => id !== input.value) : [...chosen, input.value];
        applyThemes(next);
      }));
      document.querySelector("[data-clear-themes]")?.addEventListener("click", () => applyThemes([]));

      const progress = document.getElementById("reading-progress");
      const updateProgress = () => {
        if (!progress) return;
        const room = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.transform = "scaleX(" + (room > 0 ? window.scrollY / room : 0) + ")";
        const article = document.querySelector("[data-reader-workspace]");
        if (!article) return;
        const passages = [...article.querySelectorAll("[data-passage-id]")];
        const active = [...passages].reverse().find((passage) => passage.getBoundingClientRect().top < window.innerHeight * .42) || passages[0];
        if (active) {
          localStorage.setItem(progressKey, JSON.stringify({ url: location.pathname, passage: active.id, title: document.title }));
        }
      };
      window.addEventListener("scroll", updateProgress, { passive: true });
      window.addEventListener("resize", updateProgress);
      updateProgress();
    </script>
  </body>
</html>
