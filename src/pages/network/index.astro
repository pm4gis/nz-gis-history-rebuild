---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const [recordEntries, articleEntries, passageEntries, eventEntries, relationshipEntries, themeEntries] = await Promise.all([
  getCollection("records"), getCollection("articles"), getCollection("passages"), getCollection("events"),
  getCollection("relationships"), getCollection("themes"),
]);
const records = recordEntries.map((entry) => entry.data);
const articles = articleEntries.map((entry) => entry.data).filter((article) => article.status === "published");
const passages = passageEntries.map((entry) => entry.data);
const events = eventEntries.map((entry) => entry.data);
const themes = themeEntries.map((entry) => entry.data);
const timelineYear = (event) => {
  if (Number.isFinite(event.year)) return event.year;
  const parsed = /^(\d{4})/.exec(String(event.startDate || ""));
  return parsed ? Number(parsed[1]) : Number.NaN;
};
const eventYearValues = events.map(timelineYear).filter(Number.isFinite);
const minYear = eventYearValues.length ? Math.min(...eventYearValues) : 0;
const maxYear = eventYearValues.length ? Math.max(...eventYearValues) : 0;
const recordById = new Map(records.map((record) => [record.id, record]));
const articleById = new Map(articles.map((article) => [article.id, article]));
const passageById = new Map(passages.map((passage) => [passage.id, passage]));
const graphRecordId = (id) => {
  const record = recordById.get(id);
  return record?.kind === "Story" ? record.articleId : id;
};
const passageThemes = (ids) => [...new Set((ids || []).flatMap((id) => passageById.get(id)?.themeIds || []))].filter((id) => themes.some((theme) => theme.id === id));
const articleThemeIds = (article) => [...new Set([...(article.themeIds || []), ...passageThemes(passages.filter((passage) => passage.articleId === article.id).map((passage) => passage.id))])];
const recordThemeIds = (record) => [...new Set([...(record.themeIds || []), ...passageThemes(passages.filter((passage) => (passage.recordIds || []).includes(record.id)).map((passage) => passage.id))])];
const eventThemeIds = (event) => [...new Set([...(event.themeIds || []), ...passageThemes(event.passageIds || [])])];
const directoryGroups = [
  { id: "people", label: "People", kinds: ["Person"] },
  { id: "organisations", label: "Organisations and councils", kinds: ["Organisation", "Agency", "Council"] },
  { id: "businesses", label: "Businesses", kinds: ["Business", "Company"] },
  { id: "projects", label: "Projects", kinds: ["Project"] },
  { id: "technologies", label: "Systems and technologies", kinds: ["System", "Technology"] },
  { id: "other", label: "Other records", kinds: [] },
];
const recordGroup = (record) => directoryGroups.find((group) => group.kinds.includes(record.kind))?.id || "other";
const relationContext = (basis) => /research|reconciled|cleanup|expansion|curated|chapter association|name matched|role and period require verification|existing structured/i.test(basis || "") ? "" : String(basis || "").replace(/GISList evidence connects/i, "GISList accounts connect");
const eventUrl = (event) => {
  if (event.url) return event.url;
  const passage = (event.passageIds || []).map((id) => passageById.get(id)).find(Boolean);
  const article = passage && articleById.get(passage.articleId);
  return passage && article ? `${article.url}#${passage.slug}` : "";
};
const nodes = [
  ...records.filter((record) => record.kind !== "Story").map((record) => ({ id: record.id, label: record.name, kind: record.kind, group: recordGroup(record), url: record.url, summary: record.description || record.story?.[0] || "", sourceCount: record.sources?.length || 0, themeIds: recordThemeIds(record) })),
  ...articles.map((article) => ({ id: article.id, label: article.title, kind: "Story", group: "stories", url: article.url, summary: article.summary, sourceCount: 0, themeIds: articleThemeIds(article) })),
  ...events.map((event) => ({ id: event.id, label: event.label, kind: "Event", group: "events", url: eventUrl(event), summary: event.summary, sourceCount: event.sources?.length || 0, year: timelineYear(event), dateDisplay: event.dateDisplay, datePrecision: event.datePrecision, themeIds: eventThemeIds(event) })),
  ...themes.map((theme) => ({ id: theme.id, label: theme.title, kind: "Theme", group: "themes", url: `/themes/${theme.slug}/`, summary: theme.description || "Reader theme", sourceCount: 0, themeIds: [theme.id] })),
  ...directoryGroups.map((group) => ({ id: `index:${group.id}`, label: `${group.label} index`, kind: "Index", group: group.id, url: `/browse/?kind=${group.id}`, summary: `A navigation index for ${group.label.toLocaleLowerCase()}. This catalogue link does not describe a historical relationship.`, sourceCount: 0, themeIds: [] })),
  { id: "index:collection", label: "Collection index", kind: "Index", group: "indexes", url: "/browse/", summary: "Browse all published people, organisations, projects, technologies and themes.", sourceCount: 0, themeIds: [] },
];
const eventYearsForPassages = (passageIds) => events.filter((event) => (event.passageIds || []).some((id) => passageIds.includes(id))).map(timelineYear).filter(Number.isFinite);
const passageSources = (passage) => (passage.blocks?.length ? passage.blocks : passage.paragraphs || []).flatMap((block) => block.sources || []);
const storyRecordsFor = (passage: { recordIds?: string[] }) => [...new Set<string>((passage.recordIds || []).filter((id: string) => recordById.has(id) && recordById.get(id).kind !== "Story"))];
const edges = [
  ...records.filter((record) => record.kind !== "Story").map((record) => ({ id: `directory-link:${record.id}`, a: record.id, b: `index:${recordGroup(record)}`, label: "indexed in", basis: "Directory link for navigation. This does not describe a historical relationship.", sources: [], years: [], themeIds: recordThemeIds(record), passageUrl: "" })),
  ...directoryGroups.map((group) => ({ id: `index-section:${group.id}`, a: `index:${group.id}`, b: "index:collection", label: "section of", basis: "Directory navigation link between the collection index and a section.", sources: [], years: [], themeIds: [], passageUrl: "" })),
  ...themes.map((theme) => ({ id: `theme-index:${theme.id}`, a: theme.id, b: "index:collection", label: "listed in", basis: "Theme directory link for browsing the collection.", sources: [], years: [], themeIds: [theme.id], passageUrl: "" })),
  ...relationshipEntries.map((entry) => {
    const relation = entry.data;
    const contextPassage = (relation.passageIds || []).map((id) => passageById.get(id)).find(Boolean);
    return { id: relation.id, a: graphRecordId(relation.a), b: graphRecordId(relation.b), label: relation.label, basis: relationContext(relation.basis), sources: relation.sources || [], years: eventYearsForPassages(relation.passageIds || []), themeIds: passageThemes(relation.passageIds || []), passageUrl: contextPassage ? `${articleById.get(contextPassage.articleId)?.url || "/"}#${contextPassage.slug}` : "" };
  }),
  ...passages.flatMap((passage) => {
    const article = articleById.get(passage.articleId);
    return storyRecordsFor(passage).map((recordId) => ({
      id: `story-link:${passage.id}:${recordId}`, a: passage.articleId, b: recordId,
      label: "in story", basis: `Linked in “${passage.title}”.`, sources: passageSources(passage), years: eventYearsForPassages([passage.id]),
      themeIds: passage.themeIds || [], passageUrl: `${article?.url || "/"}#${passage.slug}`,
    }));
  }),
  ...events.flatMap((event) => {
    const linkedPassages = (event.passageIds || []).map((passageId) => passageById.get(passageId)).filter(Boolean);
    const linkedIds = new Set<string>();
    for (const recordId of (event.recordIds || []) as string[]) linkedIds.add(recordId);
    for (const passage of linkedPassages) for (const recordId of storyRecordsFor(passage)) linkedIds.add(recordId);
    return [...linkedIds].filter((recordId) => recordById.has(recordId) && recordById.get(recordId).kind !== "Story").map((recordId) => ({
      id: `event-link:${event.id}:${recordId}`, a: event.id, b: recordId, label: "connected in time",
      basis: `${event.dateDisplay} · ${event.datePrecision} precision.`, sources: event.sources || [], years: [timelineYear(event)].filter(Number.isFinite),
      themeIds: eventThemeIds(event), passageUrl: linkedPassages[0] ? `${articleById.get(linkedPassages[0].articleId)?.url || "/"}#${linkedPassages[0].slug}` : "",
    }));
  }),
  ...nodes.flatMap((node) => (node.themeIds || []).filter((themeId) => themes.some((theme) => theme.id === themeId)).map((themeId) => ({
    // A theme node points to its own detail page; it should not also create a self-loop.
    id: `theme-link:${node.id}:${themeId}`, a: node.id, b: themeId, label: "theme", basis: "Tagged with this reader theme.", sources: [], years: [], themeIds: [themeId], passageUrl: "",
  })).filter((edge) => edge.a !== edge.b)),
];
const graphData = JSON.stringify({ nodes, edges, minYear, maxYear }).replace(/</g, "\\u003c");
const kindGroups = [
  ...directoryGroups.map((group) => ({ label: group.label, id: group.id })),
  { label: "Stories", id: "stories" }, { label: "Events", id: "events" }, { label: "Themes", id: "themes" }, { label: "Directory indexes", id: "indexes" },
];
const nodeGroups = new Set(nodes.map((node) => node.group));
const visibleKindGroups = kindGroups.filter((group) => nodeGroups.has(group.id));
const relationLabels = [...new Set(edges.map((edge) => edge.label))].sort();
---
<SiteLayout title="Network — A History of GIS in New Zealand" description="An optional, source-linked view of stories, records, themes and dates.">
  <section class="network-layout">
    <p class="eyebrow">Optional view · {nodes.length} nodes · {edges.length} links</p>
    <h1 class="page-title">See the connections</h1>
    <p class="page-intro">People, organisations, stories, events and themes share one network. Select a type or connection button, then choose any item to see its related passages, dates and records.</p>
    <div class="network-filter-panel" aria-label="Network filters">
      <div class="network-filter-block"><span class="filter-label">Focus on types</span><div class="choice-row" role="group" aria-label="Focus network on selected item types and their connections">
        <button class="choice-chip is-active" type="button" data-kind-all aria-pressed="true">All types</button>
        {visibleKindGroups.map((group) => <button class="choice-chip" type="button" data-kind-filter={group.id} aria-pressed="false">{group.label}</button>)}
      </div></div>
      <div class="network-filter-block"><span class="filter-label">Connection types</span><div class="choice-row" role="group" aria-label="Select connection types">
        <button class="choice-chip is-active" type="button" data-link-all aria-pressed="true">All connections</button>
        {relationLabels.map((label) => <button class="choice-chip" type="button" data-link-filter={label} aria-pressed="false">{label}</button>)}
      </div></div>
      <div class="network-range-row">
        <label class="field"><span>From year</span><input id="filter-from" type="number" inputmode="numeric" /></label>
        <label class="field"><span>To year</span><input id="filter-to" type="number" inputmode="numeric" /></label>
        <label class="checkbox-field"><input id="filter-undated" type="checkbox" checked /> Include links without a date</label>
        <button class="button-secondary" id="filter-reset" type="button">Reset filters</button>
        <span class="small muted" id="network-count" aria-live="polite">{nodes.length} items · {edges.length} links</span>
      </div>
    </div>
    <p class="network-context-note">A type selection keeps each item’s directly connected stories, events, people and organisations in view.</p>
    <div class="network-workspace">
      <div class="graph-frame">
        <div id="graph" role="img" aria-describedby="graph-help" aria-label="Interactive network of stories, records, events and themes"></div>
        <span class="graph-selection-pulse" id="graph-pulse" aria-hidden="true"></span>
        <div class="graph-overlay"><span class="graph-status-dot" aria-hidden="true"></span><span id="graph-help">Choose a name or theme to bring its story links, relationships and dates into focus.</span></div>
        <p class="graph-motion-note">Drag nodes to rearrange · scroll to zoom · select to explore</p>
      </div>
      <aside class="graph-panel" aria-labelledby="network-inspector-title">
        <p class="eyebrow">Link inspector</p><h2 id="network-inspector-title">Explore a connection</h2>
        <label class="field node-search-label" for="node-search"><span>Find any person, organisation, story or theme</span><input id="node-search" type="search" placeholder="Type a name or subject" autocomplete="off" /></label>
        <p id="node-search-count" class="small muted" aria-live="polite"></p>
        <div class="node-search-results" id="node-search-results" role="group" aria-label="Matching network items"></div>
        <div id="graph-details" class="graph-details" aria-live="polite"><p>Select a node or line. Its description, source links and related passage will appear here.</p></div>
        <button class="button-secondary" id="graph-reset" type="button">Clear selection and reset view</button>
        <button class="button-secondary" id="layout-reset" type="button">Reset node positions</button>
        <button class="button-secondary" id="copy-state" type="button">Copy this view</button>
        <span id="copy-result" class="small muted" aria-live="polite"></span>
      </aside>
    </div>
    <details class="graph-text-alt">
      <summary>Browse the network as a list</summary>
      <p>All items and links are available below without using the animated view.</p>
      <h2 class="small">Stories, records, events and themes</h2>
      <ul class="graph-text-list">{nodes.map((node) => <li><button type="button" data-focus-node={node.id}>{node.label} · {node.kind}</button></li>)}</ul>
      <h2 class="small">Connections</h2>
      <ol class="relationship-list">{edges.map((edge) => {
        const a = nodes.find((node) => node.id === edge.a);
        const b = nodes.find((node) => node.id === edge.b);
        return <li class="card relationship-card"><p>{a?.url ? <a href={a.url}>{a.label}</a> : a?.label} <strong>{edge.label}</strong> {b?.url ? <a href={b.url}>{b.label}</a> : b?.label}</p>{edge.basis && <p class="small">{edge.basis}</p>}{edge.sources?.length > 0 && <ul>{edge.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}</ul>}</li>;
      })}</ol>
    </details>
  </section>
  <script id="graph-data" type="application/json" set:html={graphData}></script>
  <script>
    // @ts-nocheck
    import { MultiUndirectedGraph } from "graphology";
    import Sigma, { DEFAULT_STYLES } from "sigma";

    const data = JSON.parse(document.getElementById("graph-data").textContent);
    const nodeById = new Map(data.nodes.map((node) => [node.id, node]));
    const edgeById = new Map(data.edges.map((edge) => [edge.id, edge]));
    const edgesByNode = new Map(data.nodes.map((node) => [node.id, []]));
    data.edges.forEach((edge) => { edgesByNode.get(edge.a)?.push(edge); edgesByNode.get(edge.b)?.push(edge); });
    const graphElement = document.getElementById("graph");
    const kindButtons = [...document.querySelectorAll("[data-kind-filter]")];
    const kindAllButton = document.querySelector("[data-kind-all]");
    const linkButtons = [...document.querySelectorAll("[data-link-filter]")];
    const linkAllButton = document.querySelector("[data-link-all]");
    const fromInput = document.getElementById("filter-from");
    const toInput = document.getElementById("filter-to");
    const undatedFilter = document.getElementById("filter-undated");
    const nodeSearch = document.getElementById("node-search");
    const nodeResults = document.getElementById("node-search-results");
    const nodeSearchCount = document.getElementById("node-search-count");
    const detailPanel = document.getElementById("graph-details");
    const graphHelp = document.getElementById("graph-help");
    const count = document.getElementById("network-count");
    const graphPulse = document.getElementById("graph-pulse");
    const palette = { Person: "#3989a0", Business: "#dc9d4c", Company: "#dc9d4c", Organisation: "#48a98c", Agency: "#48a98c", Council: "#48a98c", Project: "#9c78bb", Technology: "#d47859", System: "#d47859", Story: "#ec7462", Event: "#f4c967", Theme: "#63caba", Index: "#8a9b91" };
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let renderer;
    let graph;
    let currentThemeIds = readThemes();
    let selectedKinds = new Set();
    let selectedLinks = new Set();
    let selectedNodeId = "";
    let selectedEdgeId = "";
    let hoveredNodeId = "";
    let hoveredEdgeId = "";
    let positionAnimationToken = 0;
    let lastNodeDragEnd = -Infinity;
    const manualPositions = new Map();

    function readThemes() { try { return JSON.parse(localStorage.getItem("nzgis-reader-themes-v1") || "[]"); } catch { return []; } }
    const svgNS = "http://www.w3.org/2000/svg";
    const webgl = (() => { try { const canvas = document.createElement("canvas"); return Boolean(canvas.getContext("webgl2") || canvas.getContext("webgl")); } catch { return false; } })();
    fromInput.min = String(data.minYear); fromInput.max = String(data.maxYear); fromInput.value = String(data.minYear);
    toInput.min = String(data.minYear); toInput.max = String(data.maxYear); toInput.value = String(data.maxYear);
    const params = new URLSearchParams(location.search);
    const kindAliases = { Person: "people", Organisation: "organisations", Agency: "organisations", Council: "organisations", Business: "businesses", Company: "businesses", Project: "projects", System: "technologies", Technology: "technologies", Story: "stories", Event: "events", Theme: "themes", Index: "indexes" };
    const validGroups = new Set(data.nodes.map((node) => node.group).filter(Boolean));
    selectedKinds = new Set((params.get("kind") || "").split("|").filter(Boolean).map((value) => kindAliases[value] || value).filter((value) => validGroups.has(value)));
    selectedLinks = new Set((params.get("link") || "").split("|").filter(Boolean));
    fromInput.value = params.get("from") || String(data.minYear); toInput.value = params.get("to") || String(data.maxYear);
    selectedNodeId = params.get("focus") || "";
    const text = (parent, tag, value, className) => { const el = document.createElement(tag); el.textContent = value || ""; if (className) el.className = className; parent.append(el); return el; };
    const addLink = (parent, label, href, external = false) => { const el = document.createElement("a"); el.textContent = label; el.href = href; if (external) { el.target = "_blank"; el.rel = "noopener noreferrer"; } parent.append(el); return el; };
    const paletteColor = (node) => palette[node.kind] || "#6c9284";
    const labelKinds = ["Story", "Theme", "Organisation", "Agency", "Council", "Business", "Company", "Project", "Technology", "System"];
    const activeTheme = (node) => node.id === selectedNodeId || !currentThemeIds.length || (node.themeIds || []).some((id) => currentThemeIds.includes(id)) || currentThemeIds.includes(node.id);
    const rangeActive = () => Number(fromInput.value) > data.minYear || Number(toInput.value) < data.maxYear;
    const syncFilterButtons = () => {
      kindAllButton.setAttribute("aria-pressed", String(selectedKinds.size === 0));
      kindAllButton.classList.toggle("is-active", selectedKinds.size === 0);
      kindButtons.forEach((button) => {
        const values = button.dataset.kindFilter.split("|");
        const pressed = values.every((value) => selectedKinds.has(value));
        button.setAttribute("aria-pressed", String(pressed)); button.classList.toggle("is-active", pressed);
      });
      linkAllButton.setAttribute("aria-pressed", String(selectedLinks.size === 0));
      linkAllButton.classList.toggle("is-active", selectedLinks.size === 0);
      linkButtons.forEach((button) => {
        const pressed = selectedLinks.has(button.dataset.linkFilter);
        button.setAttribute("aria-pressed", String(pressed)); button.classList.toggle("is-active", pressed);
      });
    };
    const visibleSet = () => {
      const from = Number(fromInput.value || data.minYear); const to = Number(toInput.value || data.maxYear);
      const candidates = data.nodes.filter((node) => activeTheme(node) &&
        (node.kind !== "Event" || !rangeActive() || (Number.isFinite(node.year) ? node.year >= from && node.year <= to : undatedFilter.checked)));
      const candidateIds = new Set(candidates.map((node) => node.id));
      const edges = data.edges.filter((edge) => candidateIds.has(edge.a) && candidateIds.has(edge.b) && (!selectedLinks.size || selectedLinks.has(edge.label)) &&
        (!currentThemeIds.length || !edge.themeIds?.length || edge.themeIds.some((id) => currentThemeIds.includes(id))) &&
        (!rangeActive() || (edge.years?.length ? edge.years.some((year) => year >= from && year <= to) : undatedFilter.checked)));
      if (!selectedKinds.size) {
        const connected = new Set(edges.flatMap((edge) => [edge.a, edge.b]));
        return { nodes: candidates.filter((node) => !rangeActive() || node.kind !== "Event" || connected.has(node.id)), edges };
      }
      const focusedIds = new Set(candidates.filter((node) => selectedKinds.has(node.group)).map((node) => node.id));
      const contextEdges = edges.filter((edge) => focusedIds.has(edge.a) || focusedIds.has(edge.b));
      const visibleIds = new Set(focusedIds);
      contextEdges.forEach((edge) => { visibleIds.add(edge.a); visibleIds.add(edge.b); });
      const connected = new Set(contextEdges.flatMap((edge) => [edge.a, edge.b]));
      return { nodes: candidates.filter((node) => visibleIds.has(node.id) && (!rangeActive() || node.kind !== "Event" || connected.has(node.id))), edges: contextEdges };
    };
    const displaySet = (filtered = visibleSet()) => {
      const roots = selectedNodeId ? [selectedNodeId] : selectedEdgeId ? (() => {
        const edge = filtered.edges.find((item) => item.id === selectedEdgeId);
        return edge ? [edge.a, edge.b] : [];
      })() : [];
      if (!roots.length || roots.some((id) => !filtered.nodes.some((node) => node.id === id))) return { ...filtered, totalNodes: filtered.nodes.length };
      const rootIds = new Set(roots);
      const edges = filtered.edges.filter((edge) => rootIds.has(edge.a) || rootIds.has(edge.b));
      const nodeIds = new Set(rootIds);
      edges.forEach((edge) => { nodeIds.add(edge.a); nodeIds.add(edge.b); });
      return { nodes: filtered.nodes.filter((node) => nodeIds.has(node.id)), edges, totalNodes: filtered.nodes.length };
    };
    const address = () => {
      const query = new URLSearchParams();
      if (selectedKinds.size) query.set("kind", [...selectedKinds].join("|"));
      if (selectedLinks.size) query.set("link", [...selectedLinks].join("|"));
      if (Number(fromInput.value) !== data.minYear) query.set("from", fromInput.value);
      if (Number(toInput.value) !== data.maxYear) query.set("to", toInput.value);
      if (selectedNodeId) query.set("focus", selectedNodeId);
      history.replaceState({}, "", location.pathname + (query.toString() ? "?" + query : ""));
    };
    const clearPanel = () => detailPanel.replaceChildren();
    const renderNodeResults = () => {
      const query = nodeSearch.value.trim().toLocaleLowerCase();
      const visible = visibleSet().nodes;
      const matches = visible.filter((node) => !query || `${node.label} ${node.kind}`.toLocaleLowerCase().includes(query));
      if (selectedKinds.size) matches.sort((a, b) => Number(selectedKinds.has(b.group)) - Number(selectedKinds.has(a.group)) || (query ? a.label.localeCompare(b.label) : (edgesByNode.get(b.id)?.length || 0) - (edgesByNode.get(a.id)?.length || 0)));
      else if (!query) matches.sort((a, b) => (edgesByNode.get(b.id)?.length || 0) - (edgesByNode.get(a.id)?.length || 0));
      else matches.sort((a, b) => a.label.localeCompare(b.label));
      nodeSearchCount.textContent = query ? `${matches.length} matches` : "Connected starting points · type to search all visible items";
      nodeResults.replaceChildren();
      matches.slice(0, 16).forEach((node) => {
        const button = document.createElement("button"); button.type = "button"; button.className = "node-result";
        button.setAttribute("aria-pressed", String(node.id === selectedNodeId)); button.textContent = `${node.label} · ${node.kind}`;
        button.addEventListener("click", () => showNode(node.id)); nodeResults.append(button);
      });
      if (!matches.length) text(nodeResults, "span", "No items match these filters.", "small muted");
      if (matches.length > 16) text(nodeResults, "span", `Showing 16 of ${matches.length}. Refine the search to see another item.`, "small muted");
    };
    const syncSelection = () => {
      renderer?.refresh({ skipIndexation: true });
      graphElement.querySelectorAll("[data-node-id]").forEach((element) => {
        const id = element.dataset.nodeId;
        const isSelected = id === selectedNodeId;
        const isNearby = Boolean(selectedNodeId && edgesByNode.get(id)?.some((edge) => edge.a === selectedNodeId || edge.b === selectedNodeId));
        const isHovered = id === hoveredNodeId;
        const nearHover = Boolean(hoveredNodeId && edgesByNode.get(id)?.some((edge) => edge.a === hoveredNodeId || edge.b === hoveredNodeId));
        const selectedEdge = edgeById.get(selectedEdgeId);
        const onSelectedEdge = Boolean(selectedEdge && (selectedEdge.a === id || selectedEdge.b === id));
        element.classList.toggle("is-selected", isSelected);
        element.classList.toggle("is-highlighted", isSelected || isNearby || isHovered || nearHover || onSelectedEdge);
        element.classList.toggle("is-dimmed", Boolean((selectedNodeId || selectedEdgeId || hoveredNodeId) && !isSelected && !isNearby && !isHovered && !nearHover && !onSelectedEdge));
        element.setAttribute("aria-pressed", String(isSelected));
      });
      graphElement.querySelectorAll("[data-edge-id]").forEach((element) => {
        const id = element.dataset.edgeId;
        const edge = edgeById.get(id);
