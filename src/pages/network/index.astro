---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const [recordEntries, articleEntries, passageEntries, eventEntries, relationshipEntries, themeEntries] = await Promise.all([
  getCollection("records"), getCollection("articles"), getCollection("passages"), getCollection("events"),
  getCollection("relationships"), getCollection("themes"),
]);
const records = recordEntries.map((entry) => entry.data);
const articles = articleEntries.map((entry) => entry.data).filter((article) => article.status === "published");
const passages = passageEntries.map((entry) => entry.data);
const events = eventEntries.map((entry) => entry.data);
const themes = themeEntries.map((entry) => entry.data);
const timelineYear = (event) => {
  if (Number.isFinite(event.year)) return event.year;
  const parsed = /^(\d{4})/.exec(String(event.startDate || ""));
  return parsed ? Number(parsed[1]) : Number.NaN;
};
const eventYearValues = events.map(timelineYear).filter(Number.isFinite);
const minYear = eventYearValues.length ? Math.min(...eventYearValues) : 0;
const maxYear = eventYearValues.length ? Math.max(...eventYearValues) : 0;
const recordById = new Map(records.map((record) => [record.id, record]));
const articleById = new Map(articles.map((article) => [article.id, article]));
const passageById = new Map(passages.map((passage) => [passage.id, passage]));
const graphRecordId = (id) => {
  const record = recordById.get(id);
  return record?.kind === "Story" ? record.articleId : id;
};
const relationContext = (basis) => /research|reconciled|cleanup|expansion|curated|chapter association|name matched|role and period require verification|existing structured/i.test(basis || "") ? "" : String(basis || "").replace(/GISList evidence connects/i, "GISList accounts connect");
const eventUrl = (event) => {
  if (event.url) return event.url;
  const passage = (event.passageIds || []).map((id) => passageById.get(id)).find(Boolean);
  const article = passage && articleById.get(passage.articleId);
  return passage && article ? `${article.url}#${passage.slug}` : "";
};
const nodes = [
  ...records.filter((record) => record.kind !== "Story").map((record) => ({ id: record.id, label: record.name, kind: record.kind, url: record.url, summary: record.description || record.story?.[0] || "", sourceCount: record.sources?.length || 0, themeIds: record.themeIds || [] })),
  ...articles.map((article) => ({ id: article.id, label: article.title, kind: "Story", url: article.url, summary: article.summary, sourceCount: 0, themeIds: article.themeIds || [] })),
  ...events.map((event) => ({ id: event.id, label: event.label, kind: "Event", url: eventUrl(event), summary: event.summary, sourceCount: event.sources?.length || 0, year: timelineYear(event), dateDisplay: event.dateDisplay, datePrecision: event.datePrecision, themeIds: event.themeIds || [] })),
  ...themes.map((theme) => ({ id: theme.id, label: theme.title, kind: "Theme", url: "/", summary: theme.description || "Reader theme", sourceCount: 0, themeIds: [theme.id] })),
];
const eventYearsForPassages = (passageIds) => events.filter((event) => (event.passageIds || []).some((id) => passageIds.includes(id))).map(timelineYear).filter(Number.isFinite);
const passageSources = (passage) => (passage.blocks?.length ? passage.blocks : passage.paragraphs || []).flatMap((block) => block.sources || []);
const storyRecordsFor = (passage: { recordIds?: string[] }) => [...new Set<string>((passage.recordIds || []).filter((id: string) => recordById.has(id) && recordById.get(id).kind !== "Story"))];
const edges = [
  ...relationshipEntries.map((entry) => {
    const relation = entry.data;
    const contextPassage = (relation.passageIds || []).map((id) => passageById.get(id)).find(Boolean);
    return { id: relation.id, a: graphRecordId(relation.a), b: graphRecordId(relation.b), label: relation.label, basis: relationContext(relation.basis), sources: relation.sources || [], years: eventYearsForPassages(relation.passageIds || []), themeIds: contextPassage?.themeIds || [], passageUrl: contextPassage ? `${articleById.get(contextPassage.articleId)?.url || "/"}#${contextPassage.slug}` : "" };
  }),
  ...passages.flatMap((passage) => {
    const article = articleById.get(passage.articleId);
    return storyRecordsFor(passage).map((recordId) => ({
      id: `story-link:${passage.id}:${recordId}`, a: passage.articleId, b: recordId,
      label: "in story", basis: `Linked in “${passage.title}”.`, sources: passageSources(passage), years: eventYearsForPassages([passage.id]),
      themeIds: passage.themeIds || [], passageUrl: `${article?.url || "/"}#${passage.slug}`,
    }));
  }),
  ...events.flatMap((event) => {
    const linkedPassages = (event.passageIds || []).map((passageId) => passageById.get(passageId)).filter(Boolean);
    const linkedIds = new Set<string>();
    for (const recordId of (event.recordIds || []) as string[]) linkedIds.add(recordId);
    for (const passage of linkedPassages) for (const recordId of storyRecordsFor(passage)) linkedIds.add(recordId);
    return [...linkedIds].filter((recordId) => recordById.has(recordId) && recordById.get(recordId).kind !== "Story").map((recordId) => ({
      id: `event-link:${event.id}:${recordId}`, a: event.id, b: recordId, label: "connected in time",
      basis: `${event.dateDisplay} · ${event.datePrecision} precision.`, sources: event.sources || [], years: [timelineYear(event)].filter(Number.isFinite),
      themeIds: event.themeIds || [], passageUrl: linkedPassages[0] ? `${articleById.get(linkedPassages[0].articleId)?.url || "/"}#${linkedPassages[0].slug}` : "",
    }));
  }),
  ...nodes.flatMap((node) => (node.themeIds || []).filter((themeId) => themes.some((theme) => theme.id === themeId)).map((themeId) => ({
    id: `theme-link:${node.id}:${themeId}`, a: node.id, b: themeId, label: "theme", basis: "Tagged with this reader theme.", sources: [], years: [], themeIds: [themeId], passageUrl: "",
  }))),
];
const graphData = JSON.stringify({ nodes, edges, minYear, maxYear }).replace(/</g, "\\u003c");
const nodeKinds = [...new Set(nodes.map((node) => node.kind))].sort();
const relationLabels = [...new Set(edges.map((edge) => edge.label))].sort();
---
<SiteLayout title="Network — A History of GIS in New Zealand" description="An optional, source-linked view of stories, records, themes and dates.">
  <section class="network-layout">
    <p class="eyebrow">Optional view · {nodes.length} nodes · {edges.length} links</p>
    <h1 class="page-title">See the connections</h1>
    <p class="page-intro">This view maps the links behind the narrative. Filter by theme or year, then select a node or line to open its story, record or named source.</p>
    <div class="tool-panel network-filters" aria-label="Network filters">
      <div class="field"><label for="filter-kind">Show type</label><select id="filter-kind"><option value="">All types</option>{nodeKinds.map((kind) => <option value={kind}>{kind}</option>)}</select></div>
      <div class="field"><label for="filter-relation">Link wording</label><select id="filter-relation"><option value="">All links</option>{relationLabels.map((label) => <option value={label}>{label}</option>)}</select></div>
      <div class="field"><label for="filter-from">From year</label><input id="filter-from" type="number" /></div>
      <div class="field"><label for="filter-to">To year</label><input id="filter-to" type="number" /></div>
      <label class="checkbox-field"><input id="filter-undated" type="checkbox" checked /> Include links without a date</label>
      <button class="button-secondary" id="filter-reset" type="button">Reset filters</button>
      <span class="small muted" id="network-count" aria-live="polite">{nodes.length} items · {edges.length} links</span>
    </div>
    <div class="network-workspace">
      <div class="graph-frame">
        <div id="graph" role="img" aria-describedby="graph-help" aria-label="Interactive network of stories, records, events and themes"></div>
        <div class="graph-overlay"><span class="graph-status-dot" aria-hidden="true"></span><span id="graph-help">Select a node to focus its connections. Use the item picker or network list with a keyboard.</span></div>
        <p class="graph-motion-note">Selection animates focus · respects reduced motion</p>
      </div>
      <aside class="graph-panel" aria-labelledby="network-inspector-title">
        <p class="eyebrow">Link inspector</p><h2 id="network-inspector-title">Explore a connection</h2>
        <div class="field"><label for="node-picker">Choose a record or story</label><select id="node-picker"><option value="">Select an item</option>{nodes.map((node) => <option value={node.id}>{node.label} · {node.kind}</option>)}</select></div>
        <div id="graph-details" class="graph-details" aria-live="polite"><p>Select a node or line. Its description, source links and related passage will appear here.</p></div>
        <button class="button-secondary" id="graph-reset" type="button">Clear selection and reset view</button>
        <button class="button-secondary" id="copy-state" type="button">Copy this view</button>
        <span id="copy-result" class="small muted" aria-live="polite"></span>
      </aside>
    </div>
    <details class="graph-text-alt">
      <summary>Browse the network as a list</summary>
      <p>All items and links are available below without using the animated view.</p>
      <h2 class="small">Stories, records, events and themes</h2>
      <ul class="graph-text-list">{nodes.map((node) => <li><button type="button" data-focus-node={node.id}>{node.label} · {node.kind}</button></li>)}</ul>
      <h2 class="small">Connections</h2>
      <ol class="relationship-list">{edges.map((edge) => {
        const a = nodes.find((node) => node.id === edge.a);
        const b = nodes.find((node) => node.id === edge.b);
        return <li class="card relationship-card"><p>{a?.url ? <a href={a.url}>{a.label}</a> : a?.label} <strong>{edge.label}</strong> {b?.url ? <a href={b.url}>{b.label}</a> : b?.label}</p>{edge.basis && <p class="small">{edge.basis}</p>}{edge.sources?.length > 0 && <ul>{edge.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a></li>)}</ul>}</li>;
      })}</ol>
    </details>
  </section>
  <script id="graph-data" type="application/json" set:html={graphData}></script>
  <script>
    // @ts-nocheck
    import { MultiUndirectedGraph } from "graphology";
    import Sigma from "sigma";

    const data = JSON.parse(document.getElementById("graph-data").textContent);
    const nodeById = new Map(data.nodes.map((node) => [node.id, node]));
    const edgeById = new Map(data.edges.map((edge) => [edge.id, edge]));
    const edgesByNode = new Map(data.nodes.map((node) => [node.id, []]));
    data.edges.forEach((edge) => { edgesByNode.get(edge.a)?.push(edge); edgesByNode.get(edge.b)?.push(edge); });
    const graphElement = document.getElementById("graph");
    const kindFilter = document.getElementById("filter-kind");
    const linkFilter = document.getElementById("filter-relation");
    const fromInput = document.getElementById("filter-from");
    const toInput = document.getElementById("filter-to");
    const undatedFilter = document.getElementById("filter-undated");
    const nodePicker = document.getElementById("node-picker");
    const detailPanel = document.getElementById("graph-details");
    const count = document.getElementById("network-count");
    const palette = { Person: "#3989a0", Business: "#dc9d4c", Company: "#dc9d4c", Organisation: "#48a98c", Agency: "#48a98c", Project: "#9c78bb", Technology: "#d47859", System: "#d47859", Story: "#ec7462", Event: "#f4c967", Theme: "#63caba" };
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let renderer;
    let graph;
    let currentThemeIds = readThemes();
    let selectedNodeId = "";
    let selectedEdgeId = "";
    let hoveredNodeId = "";
    let hoveredEdgeId = "";

    function readThemes() { try { return JSON.parse(localStorage.getItem("nzgis-reader-themes-v1") || "[]"); } catch { return []; } }
    const svgNS = "http://www.w3.org/2000/svg";
    const webgl = (() => { try { const canvas = document.createElement("canvas"); return Boolean(canvas.getContext("webgl2") || canvas.getContext("webgl")); } catch { return false; } })();
    fromInput.min = String(data.minYear); fromInput.max = String(data.maxYear); fromInput.value = String(data.minYear);
    toInput.min = String(data.minYear); toInput.max = String(data.maxYear); toInput.value = String(data.maxYear);
    const params = new URLSearchParams(location.search);
    kindFilter.value = params.get("kind") || ""; linkFilter.value = params.get("link") || "";
    fromInput.value = params.get("from") || String(data.minYear); toInput.value = params.get("to") || String(data.maxYear);
    selectedNodeId = params.get("focus") || "";
    const text = (parent, tag, value, className) => { const el = document.createElement(tag); el.textContent = value || ""; if (className) el.className = className; parent.append(el); return el; };
    const addLink = (parent, label, href, external = false) => { const el = document.createElement("a"); el.textContent = label; el.href = href; if (external) { el.target = "_blank"; el.rel = "noopener noreferrer"; } parent.append(el); return el; };
    const paletteColor = (node) => palette[node.kind] || "#6c9284";
    const activeTheme = (node) => !currentThemeIds.length || (node.themeIds || []).some((id) => currentThemeIds.includes(id)) || currentThemeIds.includes(node.id);
    const rangeActive = () => Number(fromInput.value) > data.minYear || Number(toInput.value) < data.maxYear;
    const visibleSet = () => {
      const from = Number(fromInput.value || data.minYear); const to = Number(toInput.value || data.maxYear);
      const nodes = data.nodes.filter((node) => (!kindFilter.value || node.kind === kindFilter.value) && activeTheme(node) &&
        (node.kind !== "Event" || !rangeActive() || (Number.isFinite(node.year) ? node.year >= from && node.year <= to : undatedFilter.checked)));
      const ids = new Set(nodes.map((node) => node.id));
      const edges = data.edges.filter((edge) => ids.has(edge.a) && ids.has(edge.b) && (!linkFilter.value || edge.label === linkFilter.value) &&
        (!currentThemeIds.length || !edge.themeIds?.length || edge.themeIds.some((id) => currentThemeIds.includes(id))) &&
        (!rangeActive() || (edge.years?.length ? edge.years.some((year) => year >= from && year <= to) : undatedFilter.checked)));
      const connected = new Set(edges.flatMap((edge) => [edge.a, edge.b]));
      return { nodes: nodes.filter((node) => !rangeActive() || node.kind !== "Event" || connected.has(node.id)), edges };
    };
    const address = () => {
      const query = new URLSearchParams();
      if (kindFilter.value) query.set("kind", kindFilter.value);
      if (linkFilter.value) query.set("link", linkFilter.value);
      if (Number(fromInput.value) !== data.minYear) query.set("from", fromInput.value);
      if (Number(toInput.value) !== data.maxYear) query.set("to", toInput.value);
      if (selectedNodeId) query.set("focus", selectedNodeId);
      history.replaceState({}, "", location.pathname + (query.toString() ? "?" + query : ""));
    };
    const clearPanel = () => detailPanel.replaceChildren();
    const syncSelection = () => {
      renderer?.refresh();
      graphElement.querySelectorAll("[data-node-id]").forEach((element) => {
        const id = element.dataset.nodeId;
        const isSelected = id === selectedNodeId;
        const isNearby = Boolean(selectedNodeId && edgesByNode.get(id)?.some((edge) => edge.a === selectedNodeId || edge.b === selectedNodeId));
        const isHovered = id === hoveredNodeId;
        const nearHover = Boolean(hoveredNodeId && edgesByNode.get(id)?.some((edge) => edge.a === hoveredNodeId || edge.b === hoveredNodeId));
        const selectedEdge = edgeById.get(selectedEdgeId);
        const onSelectedEdge = Boolean(selectedEdge && (selectedEdge.a === id || selectedEdge.b === id));
        element.classList.toggle("is-selected", isSelected);
        element.classList.toggle("is-highlighted", isSelected || isNearby || isHovered || nearHover || onSelectedEdge);
        element.classList.toggle("is-dimmed", Boolean((selectedNodeId || selectedEdgeId || hoveredNodeId) && !isSelected && !isNearby && !isHovered && !nearHover && !onSelectedEdge));
        element.setAttribute("aria-pressed", String(isSelected));
      });
      graphElement.querySelectorAll("[data-edge-id]").forEach((element) => {
        const id = element.dataset.edgeId;
        const edge = edgeById.get(id);
        const chosenEdge = edgeById.get(selectedEdgeId);
        const related = Boolean(edge && (edge.a === selectedNodeId || edge.b === selectedNodeId || edge.a === hoveredNodeId || edge.b === hoveredNodeId || (chosenEdge && [chosenEdge.a, chosenEdge.b].some((nodeId) => edge.a === nodeId || edge.b === nodeId))));
        element.classList.toggle("is-selected", id === selectedEdgeId);
        element.classList.toggle("is-highlighted", id === selectedEdgeId || id === hoveredEdgeId || related);
        element.classList.toggle("is-dimmed", Boolean((selectedNodeId || selectedEdgeId || hoveredNodeId || hoveredEdgeId) && id !== selectedEdgeId && id !== hoveredEdgeId && !related));
        element.setAttribute("aria-pressed", String(id === selectedEdgeId));
      });
    };
    const focusPosition = (x, y, ratio = .78) => {
      if (!renderer) return;
      const camera = renderer.getCamera();
      const state = { x, y, ratio: Math.min(camera.getState().ratio, ratio) };
      if (reducedMotion.matches) camera.setState(state);
      else camera.animate(state, { duration: 420, easing: "cubicInOut" });
    };
    const focusNode = (id) => {
      if (!renderer) return;
      const attrs = renderer.getNodeDisplayData(id);
      if (!attrs) return;
      focusPosition(attrs.x, attrs.y);
    };
    const showNode = (id) => {
      const node = nodeById.get(id); if (!node) return;
      selectedNodeId = id; selectedEdgeId = ""; hoveredNodeId = ""; hoveredEdgeId = ""; nodePicker.value = id; clearPanel();
      text(detailPanel, "strong", node.label); text(detailPanel, "div", node.kind, "small muted");
      if (node.summary) text(detailPanel, "p", node.summary);
      if (node.dateDisplay) text(detailPanel, "p", `${node.dateDisplay} · ${node.datePrecision} precision`, "small muted");
      if (node.sourceCount) text(detailPanel, "p", `${node.sourceCount} source ${node.sourceCount === 1 ? "reference" : "references"} attached.`, "small muted");
      if (node.url && node.kind !== "Theme") addLink(detailPanel, node.kind === "Story" ? "Read this story →" : node.kind === "Event" ? "Open its passage →" : "Open record →", node.url);
      const connected = edgesByNode.get(id) || [];
      if (connected.length) {
        text(detailPanel, "h3", `Connected items · ${connected.length}`);
        const list = document.createElement("ul"); list.className = "graph-related-list";
        connected.forEach((edge) => {
          const other = nodeById.get(edge.a === id ? edge.b : edge.a);
          if (!other) return;
          const item = document.createElement("li");
          if (other.url && other.kind !== "Theme") addLink(item, `${other.label} · ${other.kind}`, other.url);
          else text(item, "span", `${other.label} · ${other.kind}`);
          const relation = document.createElement("button"); relation.type = "button"; relation.className = "relationship-open";
          relation.textContent = `${edge.label} · view connection details`;
          relation.addEventListener("click", () => showEdge(edge.id)); item.append(relation); list.append(item);
        });
        detailPanel.append(list);
      }
      address(); syncSelection(); focusNode(id);
    };
    const showEdge = (id) => {
      const edge = edgeById.get(id); if (!edge) return;
      selectedEdgeId = id; selectedNodeId = ""; hoveredNodeId = ""; hoveredEdgeId = ""; nodePicker.value = ""; clearPanel();
      const a = nodeById.get(edge.a); const b = nodeById.get(edge.b);
      text(detailPanel, "strong", `${a?.label || "Item"} ${edge.label} ${b?.label || "item"}`);
      if (edge.basis) text(detailPanel, "p", edge.basis);
      if (a?.url && a.kind !== "Theme") addLink(detailPanel, `Open ${a.label} →`, a.url);
      if (b?.url && b.kind !== "Theme") addLink(detailPanel, `Open ${b.label} →`, b.url);
      if (edge.passageUrl) addLink(detailPanel, "Read the related passage →", edge.passageUrl);
      if (edge.sources?.length) {
        const list = document.createElement("ul");
        edge.sources.forEach((source) => { const li = document.createElement("li"); addLink(li, `${source.label} ↗`, source.url || "#", Boolean(source.url && source.url.startsWith("http"))); list.append(li); });
        detailPanel.append(list);
      }
      address(); syncSelection();
      if (a && b && graph?.hasNode(a.id) && graph?.hasNode(b.id)) {
        const aa = renderer.getNodeDisplayData(a.id); const bb = renderer.getNodeDisplayData(b.id);
        if (!aa || !bb) return;
        focusPosition((aa.x + bb.x) / 2, (aa.y + bb.y) / 2, .85);
      }
    };
    const nodePosition = (node, index, total) => {
      const ring = node.kind === "Theme" ? 1.03 : node.kind === "Event" ? .48 : node.kind === "Story" ? .30 : .76;
      const seed = (index * 2.399963 + (node.kind === "Event" ? .65 : node.kind === "Theme" ? 1.1 : node.kind === "Story" ? .2 : 0));
      return { x: Math.cos(seed) * ring, y: Math.sin(seed) * ring };
    };
    const svgNode = (name, attrs = {}) => { const el = document.createElementNS(svgNS, name); Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, String(value))); return el; };
    const drawSVG = (nodes, edges) => {
      graphElement.replaceChildren();
      const svg = svgNode("svg", { viewBox: "0 0 900 620", class: "network-svg", role: "group", "aria-label": "Network diagram. Use Tab to inspect nodes and links." });
      const points = new Map(nodes.map((node, index) => { const point = nodePosition(node, index, nodes.length); return [node.id, { x: 450 + point.x * 335, y: 310 + point.y * 235 }]; }));
      edges.forEach((edge) => {
        const a = points.get(edge.a); const b = points.get(edge.b); if (!a || !b) return;
        const group = svgNode("g", { tabindex: "0", role: "button", "aria-pressed": String(selectedEdgeId === edge.id), "data-edge-id": edge.id, class: `network-svg-edge${selectedEdgeId === edge.id ? " is-selected is-highlighted" : ""}`, "aria-label": `${nodeById.get(edge.a)?.label} ${edge.label} ${nodeById.get(edge.b)?.label}` });
        group.append(svgNode("line", { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: selectedEdgeId === edge.id ? "edge-selected" : "" }));
        group.append(svgNode("line", { x1: a.x, y1: a.y, x2: b.x, y2: b.y, class: "edge-hit" }));
        group.addEventListener("click", () => showEdge(edge.id)); group.addEventListener("keydown", (event) => { if (["Enter", " "].includes(event.key)) { event.preventDefault(); showEdge(edge.id); } }); svg.append(group);
      });
      nodes.forEach((node) => {
        const p = points.get(node.id); const isSelected = selectedNodeId === node.id; const g = svgNode("g", { tabindex: "0", role: "button", "aria-pressed": String(isSelected), "data-node-id": node.id, class: `network-svg-node${isSelected ? " is-selected is-highlighted" : ""}`, "aria-label": `Inspect ${node.label}, ${node.kind}` });
        g.append(svgNode("circle", { cx: p.x, cy: p.y, r: node.kind === "Story" ? 14 : 9, fill: paletteColor(node) }));
        const label = svgNode("text", { x: p.x, y: p.y + 24, "text-anchor": "middle" }); label.textContent = node.label.length > 25 ? node.label.slice(0, 22) + "…" : node.label; g.append(label);
        g.addEventListener("click", () => showNode(node.id)); g.addEventListener("focus", () => { hoveredNodeId = node.id; syncSelection(); }); g.addEventListener("blur", () => { hoveredNodeId = ""; syncSelection(); }); g.addEventListener("keydown", (event) => { if (["Enter", " "].includes(event.key)) { event.preventDefault(); showNode(node.id); } }); svg.append(g);
      });
      graphElement.append(svg);
    };
    const draw = () => {
      const { nodes, edges } = visibleSet();
      if (renderer) { renderer.kill(); renderer = undefined; }
      graphElement.replaceChildren();
      if (!webgl) drawSVG(nodes, edges);
      else {
        graph = new MultiUndirectedGraph();
        nodes.forEach((node, index) => {
          const p = nodePosition(node, index, nodes.length);
          graph.addNode(node.id, { label: node.label, x: p.x, y: p.y, size: selectedNodeId === node.id ? 11 : node.kind === "Story" ? 10 : node.kind === "Theme" ? 7 : 6, color: selectedNodeId === node.id ? "#f0b562" : paletteColor(node), kind: node.kind });
        });
        edges.forEach((edge) => { if (graph.hasNode(edge.a) && graph.hasNode(edge.b)) graph.addUndirectedEdgeWithKey(edge.id, edge.a, edge.b, { label: edge.label, size: selectedEdgeId === edge.id ? 2.5 : 1.3, color: selectedEdgeId === edge.id ? "#f0b562" : "#7d9a8f" }); });
        renderer = new Sigma(graph, graphElement, {
          renderEdgeLabels: false, labelRenderedSizeThreshold: 5, labelDensity: .18, labelGridCellSize: 85,
          defaultNodeColor: "#48a98c", defaultEdgeColor: "#78948a", enableEdgeEvents: true,
          nodeReducer: (key, attrs) => {
            const focusId = selectedNodeId || hoveredNodeId;
            const focusEdge = edgeById.get(selectedEdgeId);
            const onFocusEdge = Boolean(focusEdge && (key === focusEdge.a || key === focusEdge.b));
            const nearFocus = Boolean(focusId && (key === focusId || graph.hasEdge(key, focusId)));
            if (!focusId && !selectedEdgeId) return attrs;
            if (key === selectedNodeId) return { ...attrs, color: "#f0b562", size: attrs.size * 1.45, highlighted: true };
            if (key === hoveredNodeId) return { ...attrs, size: attrs.size * 1.35, highlighted: true };
            if (onFocusEdge) return { ...attrs, color: "#d7aa72", size: attrs.size * 1.18, highlighted: true };
            if (nearFocus) return { ...attrs, size: attrs.size * 1.12 };
            return { ...attrs, color: "#b6c2bb", size: attrs.size * .84 };
          },
          edgeReducer: (key, attrs) => {
            const [source, target] = graph.extremities(key);
            const selectedEdge = edgeById.get(selectedEdgeId);
            const related = [selectedNodeId, hoveredNodeId, selectedEdge?.a, selectedEdge?.b].some((id) => id && (source === id || target === id));
            if (key === selectedEdgeId || key === hoveredEdgeId) return { ...attrs, color: "#e3a14f", size: 2.5 };
            if (related) return { ...attrs, color: "#728b7e", size: 1.8 };
            if (selectedNodeId || selectedEdgeId || hoveredNodeId || hoveredEdgeId) return { ...attrs, color: "#d3dbd6", size: .9 };
            return attrs;
          },
        });
        renderer.on("clickNode", ({ node }) => showNode(node)); renderer.on("clickEdge", ({ edge }) => showEdge(edge));
        renderer.on("enterNode", ({ node }) => { hoveredNodeId = node; renderer.refresh(); });
        renderer.on("leaveNode", ({ node }) => { if (hoveredNodeId === node) { hoveredNodeId = ""; renderer.refresh(); } });
        renderer.on("enterEdge", ({ edge }) => { hoveredEdgeId = edge; renderer.refresh(); });
        renderer.on("leaveEdge", ({ edge }) => { if (hoveredEdgeId === edge) { hoveredEdgeId = ""; renderer.refresh(); } });
      }
      count.textContent = `${nodes.length} visible items · ${edges.length} visible links`;
    };
    const updateAddressAndDraw = () => { draw(); address(); };
    [kindFilter, linkFilter, fromInput, toInput, undatedFilter].forEach((control) => control.addEventListener("change", updateAddressAndDraw));
    nodePicker.addEventListener("change", () => nodePicker.value && showNode(nodePicker.value));
    document.querySelectorAll("[data-focus-node]").forEach((button) => button.addEventListener("click", () => showNode(button.dataset.focusNode)));
    document.querySelectorAll("[data-focus-edge]").forEach((button) => button.addEventListener("click", () => showEdge(button.dataset.focusEdge)));
    document.getElementById("filter-reset").addEventListener("click", () => { kindFilter.value = ""; linkFilter.value = ""; fromInput.value = data.minYear; toInput.value = data.maxYear; undatedFilter.checked = true; selectedNodeId = ""; selectedEdgeId = ""; updateAddressAndDraw(); });
    document.getElementById("graph-reset").addEventListener("click", () => {
      selectedNodeId = ""; selectedEdgeId = ""; hoveredNodeId = ""; hoveredEdgeId = ""; nodePicker.value = "";
      clearPanel(); text(detailPanel, "p", "Select a node or line. Its description, source links and connected items will appear here.");
      address(); syncSelection();
      if (renderer) {
        const camera = renderer.getCamera();
        if (reducedMotion.matches) camera.setState({ x: .5, y: .5, angle: 0, ratio: 1 });
        else camera.animate({ x: .5, y: .5, angle: 0, ratio: 1 }, { duration: 360, easing: "cubicInOut" });
      }
    });
    document.getElementById("copy-state").addEventListener("click", async () => { const label = document.getElementById("copy-result"); try { await navigator.clipboard.writeText(location.href); label.textContent = "View link copied."; } catch { label.textContent = "Copy is unavailable here. Copy the address from your browser."; } });
    window.addEventListener("reader:themes-changed", (event) => { currentThemeIds = event.detail.themes; updateAddressAndDraw(); });
    reducedMotion.addEventListener?.("change", () => { if (reducedMotion.matches) renderer?.getCamera().cancelAnimation(); });
    draw();
    if (selectedNodeId && nodeById.has(selectedNodeId)) showNode(selectedNodeId);
  </script>
</SiteLayout>
