---
import SiteLayout from "../layouts/SiteLayout.astro";
import BookReader from "../components/BookReader.astro";
import { getCollection } from "astro:content";

const [articleEntries, passageEntries, recordEntries, relationshipEntries, eventEntries, imageEntries] = await Promise.all([
  getCollection("articles"), getCollection("passages"), getCollection("records"), getCollection("relationships"), getCollection("events"), getCollection("images"),
]);
const articles = articleEntries.map((entry) => entry.data)
  .filter((article) => article.status === "published")
  .sort((a, b) => (a.readingOrder ?? Number.MAX_SAFE_INTEGER) - (b.readingOrder ?? Number.MAX_SAFE_INTEGER) || a.title.localeCompare(b.title));
const firstPassage = passageEntries.map((entry) => entry.data).sort((a, b) => a.order - b.order)[0];
const recordCount = recordEntries.filter((entry) => entry.data.kind !== "Story").length;
const relationships = relationshipEntries.map((entry) => entry.data);
const passageCount = passageEntries.length;
---

<SiteLayout title="A History of GIS in New Zealand" description="Read a linked history of people, organisations, projects, datasets and technologies that shaped GIS in New Zealand." pageClass="book-home-page">
  <header class="book-intro" id="book-top">
    <p class="eyebrow">Aotearoa New Zealand · GIS history</p>
    <h1>A History of GIS in New Zealand</h1>
    <p class="book-intro-lead">Read the history as a continuous book. Follow the people, organisations, councils, businesses, public agencies, systems and projects through the passages, then open the linked records and sources as you go.</p>
    <div class="book-intro-actions">
      {firstPassage && <a class="button" href={`#book-section-${articles[0]?.slug || firstPassage.slug}`}>Start reading <span aria-hidden="true">↓</span></a>}
      <a class="button-secondary" href="/browse/">Browse people and organisations</a>
      <a class="button-secondary" href="/timeline/">Open chronology</a>
    </div>
    <p class="book-intro-note">{passageCount} passages · {recordCount} linked records · {eventEntries.length} dated events</p>
  </header>

  <section class="book-navigation" aria-label="Explore the collection">
    <a href="/search/">Search names, places, systems and stories <span aria-hidden="true">↗</span></a>
    <a href="/browse/">Browse people, organisations, businesses, agencies and councils <span aria-hidden="true">↗</span></a>
    <a href="/network/">Explore the full connections network <span aria-hidden="true">↗</span></a>
  </section>

  <BookReader articles={articles} passages={passageEntries.map((entry) => entry.data)} records={recordEntries.map((entry) => entry.data)} relationships={relationships} events={eventEntries.map((entry) => entry.data)} images={imageEntries.map((entry) => entry.data)} />
</SiteLayout>
