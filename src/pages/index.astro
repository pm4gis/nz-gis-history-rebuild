---
import SiteLayout from "../layouts/SiteLayout.astro";
import StoryReader from "../components/StoryReader.astro";
import { getCollection } from "astro:content";

const [articleEntries, passageEntries, recordEntries, eventEntries, relationshipEntries, themeEntries, imageEntries] = await Promise.all([
  getCollection("articles"), getCollection("passages"), getCollection("records"), getCollection("events"),
  getCollection("relationships"), getCollection("themes"), getCollection("images"),
]);
const articles = articleEntries.map((entry) => entry.data).filter((article) => article.status === "published")
  .sort((a, b) => Number(Boolean(b.featured)) - Number(Boolean(a.featured)) || b.updatedAt.localeCompare(a.updatedAt));
const featured = articles[0];
const storyPassages = featured ? passageEntries.map((entry) => entry.data).filter((passage) => passage.articleId === featured.id).sort((a, b) => a.order - b.order) : [];
const image = imageEntries[0]?.data;
const getPageTitle = (article) => article ? article.title + " — A History of GIS in New Zealand" : "A History of GIS in New Zealand";
---

<SiteLayout title={getPageTitle(featured)} description={featured?.summary || "An evolving, linked history of GIS in Aotearoa New Zealand."} pageClass="home-reader">
  {featured ? <StoryReader article={featured} passages={storyPassages} themes={themeEntries.map((entry) => entry.data)} records={recordEntries.map((entry) => entry.data)} events={eventEntries.map((entry) => entry.data)} relationships={relationshipEntries.map((entry) => entry.data)} /> : <section class="empty-reader"><p class="eyebrow">Reader workspace</p><h1>Stories are being prepared</h1><p>When an article is published, it will appear here. More passages can be added as the story grows.</p></section>}

  <section class="home-after-reader" aria-label="More to explore">
    <div class="home-after-heading"><div><p class="eyebrow">Keep exploring</p><h2>Follow the threads</h2></div><p>Each person, organisation, project and image opens as its own page.</p></div>
    <div class="explore-cards">
      <a class="explore-card" href="/browse/"><span class="explore-card-icon" aria-hidden="true">⌘</span><span><strong>People &amp; organisations</strong><small>Open the connected records</small></span><span aria-hidden="true">↗</span></a>
      <a class="explore-card" href="/timeline/"><span class="explore-card-icon" aria-hidden="true">◷</span><span><strong>Browse time</strong><small>See the published milestones</small></span><span aria-hidden="true">↗</span></a>
      <a class="explore-card" href="/network/"><span class="explore-card-icon" aria-hidden="true">⌘</span><span><strong>Open the network</strong><small>Explore the wider set of links</small></span><span aria-hidden="true">↗</span></a>
    </div>
    {articles.length > 1 && <div class="recent-stories"><h2>Recent story updates</h2><ul>{articles.slice(1).map((article) => <li><a href={article.url}><span>{article.title}</span><small>Updated {article.updatedAt}</small></a></li>)}</ul></div>}
    {image && <a class="image-feature" href={`/images/${image.slug}/`}>
      <img src={image.assetPath} alt={image.altText} width="1800" height="520" loading="lazy" />
      <span class="image-feature-overlay"><span class="eyebrow">From the image archive</span><strong>{image.title}</strong><small>{image.credit} · Image details and source ↗</small></span>
    </a>}
  </section>
</SiteLayout>
