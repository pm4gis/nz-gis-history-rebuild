---
import SiteLayout from "../../layouts/SiteLayout.astro";
---
<SiteLayout title="Search — A History of GIS in New Zealand" description="Search stories, records, themes, images and timeline events.">
  <section class="page-wrap">
    <p class="eyebrow">Pagefind · Static full-text index</p>
    <h1 class="page-title">Search the publication</h1>
    <p class="page-intro">Search the stories, people, organisations, projects, technologies, dates and named sources.</p>
    <div class="search-box"><div id="pagefind"></div></div>
    <p class="small muted">The search index is rebuilt when the collection is published. Your search runs in this browser; your query is not sent to a server.</p>
  </section>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (window.PagefindUI) new window.PagefindUI({ element: "#pagefind", showImages: false, showSubResults: true, resetStyles: false });
    });
  </script>
</SiteLayout>
