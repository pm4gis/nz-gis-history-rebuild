---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
const images = (await getCollection("images")).map((entry) => entry.data).sort((a, b) => a.title.localeCompare(b.title));
---
<SiteLayout title="Image archive — A History of GIS in New Zealand" description="Images with their source, credit and reuse details.">
  <section class="image-index page-wrap">
    <p class="eyebrow">Image archive</p><h1 class="page-title">Images and their stories</h1>
    <p class="page-intro">Each image has a separate page with its original source, credit and licence details.</p>
    <div class="image-index-grid">{images.map((image) => <a class="image-index-card" href={`/images/${image.slug}/`}>
      <img src={image.assetPath} alt={image.altText} loading="lazy" />
      <span><strong>{image.title}</strong><small>{image.credit} · View image details ↗</small></span>
    </a>)}</div>
    {!images.length && <p>No images are published in this sample yet.</p>}
  </section>
</SiteLayout>
