---
import SiteLayout from "../layouts/SiteLayout.astro";
import SourceList from "../components/SourceList.astro";
import { getCollection } from "astro:content";

const [recordEntries, relationshipEntries, eventEntries, articleEntries, passageEntries, themeEntries] = await Promise.all([
  getCollection("records"), getCollection("relationships"), getCollection("events"),
  getCollection("articles"), getCollection("passages"), getCollection("themes"),
]);
const records = recordEntries.map((entry) => entry.data);
const recordById = new Map(records.map((record) => [record.id, record]));
export async function getStaticPaths() {
  const entries = await getCollection("records");
  return entries.filter((entry) => entry.data.kind !== "Story").map((entry) => ({ params: { path: entry.data.url.replace(/^\//, "").replace(/\/$/, "") }, props: { recordId: entry.data.id } }));
}
const { recordId } = Astro.props;
const record = recordById.get(recordId);
const relatedLinks = relationshipEntries.map((entry) => entry.data).filter((relation) => relation.a === recordId || relation.b === recordId);
const connectedPassages = passageEntries.map((entry) => entry.data).filter((passage) => (passage.recordIds || []).includes(recordId));
const recordEvents = eventEntries.map((entry) => entry.data).filter((event) => (event.recordIds || []).includes(recordId) || (event.passageIds || []).some((passageId) => connectedPassages.some((passage) => passage.id === passageId)));
const articlesById = new Map(articleEntries.map((entry) => [entry.data.id, entry.data]));
const themesById = new Map(themeEntries.map((entry) => [entry.data.id, entry.data]));
const currentThemeIds = new Set([...(record?.themeIds || []), ...connectedPassages.flatMap((passage) => passage.themeIds || [])]);
const currentThemes = [...currentThemeIds].map((id) => themesById.get(id)).filter(Boolean);
const toYearLabel = (event) => `${event.dateDisplay} · ${event.datePrecision} precision`;
const datePrecisionLabel = (event) => `${event.dateDisplay} · ${String(event.datePrecision).replace("-", " ")} precision`;
const displayRelationContext = (basis) => /research|reconciled|cleanup|expansion|curated|chapter association|name matched|role and period require verification|existing structured/i.test(basis || "") ? "" : String(basis || "").replace(/GISList evidence connects/i, "GISList accounts connect");
const eventHref = (event) => event.url || (() => {
  const passage = passageEntries.map((entry) => entry.data).find((item) => (event.passageIds || []).includes(item.id));
  const article = passage && articlesById.get(passage.articleId);
  return passage && article ? `${article.url}#${passage.slug}` : "/timeline/";
})();
---

{record ? <SiteLayout title={`${record.name} — A History of GIS in New Zealand`} description={(record.description || record.story?.[0] || record.name).slice(0, 155)}>
  <article class="record-page page-wrap">
    <div class="record-page-head">
      <p class="eyebrow">{record.category || record.kind} <span aria-hidden="true">/</span> Record</p>
      <p class="record-updated">{record.status || "Published record"}</p>
      <h1 class="page-title">{record.name}</h1>
      <p class="page-intro">{record.description || record.story?.[0] || "A linked record in the NZ GIS History collection."}</p>
      <div class="theme-tags">{currentThemes.map((theme) => <a class="theme-tag" href={`/themes/${theme.slug}/`} style={`--theme-color:${theme.color || "#55b9a7"}`}>{theme.title}<span aria-hidden="true"> ↗</span></a>)}</div>
      <div class="record-network-actions"><a class="button-secondary" href={`/network/?focus=${encodeURIComponent(record.id)}`}>Explore this record in the network <span aria-hidden="true">↗</span></a></div>
    </div>

    <div class="record-page-grid">
      <div class="record-narrative">
        {(record.story || []).map((paragraph, index) => {
          const sources = record.biographyParagraphSources?.[index]?.length ? record.biographyParagraphSources[index] : (record.paragraphSources?.[index] || []);
          return <div class="record-paragraph-group"><p class="record-paragraph">{paragraph}</p>{sources.length > 0 && <details class="passage-sources"><summary>Sources <span>{sources.length}</span></summary><SourceList sources={sources} heading="Sources for this paragraph" /></details>}</div>;
        })}
        {(record.contentSections || []).map((section) => <section class="record-related-section"><h2>{section.title}</h2>{(section.paragraphs || []).map((paragraph) => <p class="record-paragraph">{paragraph}</p>)}</section>)}
        {record.recollections?.length > 0 && <section class="record-related-section"><p class="eyebrow">Personal recollections</p>{record.recollections.map((recollection) => <blockquote>{recollection}</blockquote>)}</section>}
        {record.photoGallery && <details class="record-gallery-notes"><summary>{record.photoGallery.title} <span>{record.photoGallery.items?.length || 0} descriptions</span></summary><p>{record.photoGallery.intro}</p><ul>{(record.photoGallery.items || []).map((item) => <li><strong>{item.alt}</strong><p>{item.caption}</p>{item.people?.map((group) => <small>{group.label}: {group.ids.map((id) => recordById.get(id)?.name || id).join(", ")}</small>)}</li>)}</ul><p class="small muted">The source package included the published captions and credits, but not these image files.</p></details>}
        {record.contextLinks?.length > 0 && <section class="record-related-section"><p class="eyebrow">Related links</p><ul>{record.contextLinks.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul></section>}
        {connectedPassages.length > 0 && <section class="record-related-section"><p class="eyebrow">Stories</p><h2>In the narrative</h2><ul>{connectedPassages.map((passage) => {
          const article = articlesById.get(passage.articleId);
          return <li><a href={`${article?.url || "/"}#${passage.slug}`}>{article?.title || "Open story"} <span aria-hidden="true">→</span><small>{passage.title}</small></a></li>;
        })}</ul></section>}
        {recordEvents.length > 0 && <section class="record-related-section"><p class="eyebrow">Timeline</p><h2>Dates in the reader</h2><ul>{recordEvents.map((event) => <li><a href={eventHref(event)}>{event.dateDisplay} · {event.label}<small>{toYearLabel(event)}</small></a></li>)}</ul></section>}
        {relatedLinks.length > 0 && <section class="record-related-section"><p class="eyebrow">Connections</p><h2>Related records</h2><ul>{relatedLinks.map((relation) => {
          const other = recordById.get(relation.a === recordId ? relation.b : relation.a);
          const contextPassage = passageEntries.map((entry) => entry.data).find((passage) => (relation.passageIds || []).includes(passage.id));
const contextArticle = contextPassage && articlesById.get(contextPassage.articleId);
          return <li><a href={other?.url || "/network/"}><span class="relation-verb">{relation.label}</span> {other?.name || "Related record"}{displayRelationContext(relation.basis) && <small>{displayRelationContext(relation.basis)}</small>}</a>{contextPassage && <p class="relation-context">In <a href={`${contextArticle?.url || "/"}#${contextPassage.slug}`}>{contextPassage.title}</a></p>}</li>;
        })}</ul><a class="text-link" href={`/network/?focus=${encodeURIComponent(recordId)}`}>Open this record in the network <span aria-hidden="true">↗</span></a></section>}
        <SourceList sources={record.sources} heading="Sources and further reading" />
      </div>
      <aside class="record-facts" aria-label="Record details">
        <div class="context-card"><p class="eyebrow">Record at a glance</p><dl>
          <div><dt>Type</dt><dd>{record.kind}</dd></div>
          {record.coverageEnd && <div><dt>Coverage</dt><dd>Through {record.coverageEnd}</dd></div>}
          {record.currentCouncil && <div><dt>Status</dt><dd>Current council</dd></div>}
          {record.website && <div><dt>Website</dt><dd><a href={record.website} target="_blank" rel="noopener noreferrer">Visit organisation ↗</a></dd></div>}
        </dl></div>
        {recordEvents.length > 0 && <div class="context-card"><p class="eyebrow">On the timeline</p>{recordEvents.map((event) => <p class="fact-date"><strong>{event.dateDisplay}</strong><span>{event.label}</span><small>{datePrecisionLabel(event)}</small></p>)}</div>}
      </aside>
    </div>
  </article>
</SiteLayout> : <SiteLayout title="Record not found — A History of GIS in New Zealand">
  <section class="not-found"><p class="eyebrow">Record</p><h1 class="page-title">This record is not in the collection</h1><p class="page-intro">Try another linked record or open the browse index.</p><p><a class="button" href="/browse/">Browse records</a></p></section>
</SiteLayout>}
