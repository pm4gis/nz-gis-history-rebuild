{
  "name": "nz-gis-history-rebuild",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "node scripts/copy-decap.mjs",
    "import:baseline": "node scripts/import-canonical-baseline.mjs",
    "validate": "node scripts/validate-content.mjs",
    "build:site": "astro check && astro build",
    "build:search": "pagefind --site dist",
    "verify:dist": "node scripts/verify-dist.mjs",
    "build": "npm run validate && npm run build:site && npm run build:search && npm run verify:dist",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "^7.3.8",
    "decap-cms": "^3.0.0",
    "graphology": "^0.26.0",
    "pagefind": "^1.4.0",
    "sigma": "4.0.0-beta.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "typescript": "^5.8.0"
  }
}
